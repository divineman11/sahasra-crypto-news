DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cryptonews?schema=public"
REDIS_URL="redis://localhost:6379"
WS_PORT=4181
NEXT_PUBLIC_WS_URL="ws://localhost:4181"
INGEST_INTERVAL_MS=5000
# --- Real news ingest ---
# Discord webhook for news + source-health alerts (empty = alerts off)
DISCORD_NEWS_WEBHOOK=""
# Your watch-list coins, comma-separated (used for Discord alerts and the fastest Google News tier)
NEWS_PORTFOLIO=""
# SEC press-release feed: SEC requires a declared User-Agent with a contact email, e.g. "CryptoNewsTerminal/1.0 you@example.com" (empty = SEC feed off)
SEC_USER_AGENT=""
# Where the per-coin news summary JSON is written (optional; default app/news_live.json)
NEWS_LIVE_JSON=""
# --- Reddit Social tab. Works WITHOUT keys: one keyless multireddit /hot/.rss request every 10 min (Reddit no longer issues free script apps). If Reddit approves an API request, fill all four below to switch to OAuth mode automatically. (app type "script" at https://www.reddit.com/prefs/apps once approved)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USERNAME=""
REDDIT_PASSWORD=""
# The script-app account MUST have 2FA disabled. Appending a one-time code to the
# password only satisfies Reddit's password grant for the very first token — the grant re-runs on
# its own roughly every hour, and there is no way to keep supplying a fresh code automatically, so
# the adapter starts failing auth again within an hour. Use a dedicated Reddit account for this app
# and turn 2FA off on it (not your main account).
# Optional; OAuth default "SahasraNews/1.0 (by u/<REDDIT_USERNAME>)", RSS default "SahasraNews/1.0 (self-hosted RSS reader)" (Reddit 403s the web:... UA form on RSS)
REDDIT_USER_AGENT=""

# --- Per-coin Google News ---
# Master on/off switch for the gnews adapter (1 = on, default)
GNEWS_ENABLED="1"
# Which coin tiers to poll: A = your NEWS_PORTFOLIO coins (>=20 min), B = top-100 by volume minus A
# (>=60 min, budget-derived), C = every other coin base (>=12 h, batched 4 default-record coins
# per request; curated coins get their own request); with roughly >=60 tier-A coins, tier A alone
# consumes most of the daily budget and B/C intervals blow up to many hours/days — effectively
# paused, though not literally disabled. Comma-separated, any subset of A,B,C. Recommended for the
# first day: "A,B" (skip the slow/low-value C tier until A/B are proven out).
GNEWS_TIERS="A,B,C"
# Max Google News requests per UTC calendar day across all tiers combined; the counter resets when
# the UTC date changes (not a rolling 24h window)
GNEWS_DAILY_BUDGET="5000"
# Minimum tier-A polling interval in minutes (a floor). The actual interval is
# max(this, ceil(1440 * nA / (0.9 * GNEWS_DAILY_BUDGET))) where nA is the tier-A coin count — e.g.
# stays at the 20-minute floor up to ~62 tier-A coins at the default budget. Raise it (e.g. 30) to
# leave more of the daily budget for tiers B/C.
GNEWS_TIER_A_MIN="20"
# Where gnews persists its per-coin schedule (nextDueAt, lastOkAt, firstDone, tier, lastListedAt)
# plus the current UTC day's request counter, between restarts
# (default: app/ingest/cache/gnews_state.json)
GNEWS_STATE_FILE=""

# --- Per-source enable switches (all default ON — "1" — set to "0" to disable) ---
# Telegram wire channels (TreeNewsFeed, Walter_Bloomberg, WatcherGuru, wublockchainenglish,
# whale_alert_io) — does not affect the dedicated tg:bwenews adapter
TG_WIRES_ENABLED="1"
# GitHub releases / governance forum / project blog sources (officialSources.json)
OFFICIAL_ENABLED="1"
# YouTube Media tab channels (YT_CHANNELS in config.js)
YOUTUBE_ENABLED="1"
# Reddit Social tab (config.js REDDIT_SUBS). RSS mode needs no credentials.
REDDIT_ENABLED="1"
REDDIT_RSS_ENABLED="1"   # 0 = no keyless RSS polling (only OAuth, if keys are set)
REDDIT_RSS_INTERVAL_MS="600000"
# --- Bluesky Social tab: curated accounts in config.js BSKY_ACCOUNTS, keyless public API, one poll of all accounts every 10 min (floor 6 min)
BLUESKY_ENABLED="1"
BLUESKY_INTERVAL_MS="600000"
BLUESKY_USER_AGENT=""

# --- Misc ---
# Set to "off" to use the in-memory Redis stand-in instead of a real WSL/Redis instance. Leave
# empty when running via supervisor.js in its default (no --with-ui) mode — it sets NEWS_REDIS=off
# itself for the ingest child process there, overriding whatever this file has; set it to "off"
# explicitly when running `node ingest.js` by hand without Redis (supervisor.js --with-ui instead
# starts a real WSL Redis and does not override this var, so leave it unset there too).
NEWS_REDIS=""
# Cache of Binance non-coin perp bases (stocks/commodities/indexes, from exchangeInfo's
# underlyingType) that the tagger never tags as a coin (default: app/ingest/cache/noncoin.json)
NONCOIN_CACHE_FILE=""
# Max rows fetched per news_live.json write for important items (importance>=50) / for ordinary per-coin counts (defaults 5000 / 20000)
NEWSFILE_IMPORTANT_TAKE=""
NEWSFILE_COUNTS_TAKE=""
# --- Trump section (separate from the crypto feed): Truth Social posts every 2 min + Trump market news every 5 min. 0 = off
TRUMP_ENABLED="1"
TRUMP_GNEWS_INTERVAL_MIN="15"     # Google News searches for the Trump section run every N minutes (min 5)
TRUMP_GNEWS_DAILY_BUDGET="2000"   # daily cap on Google requests from the Trump section; see docs/TRUMP.md